[Unit]
Description=Update the Sendayan Line 2 tracker for %i (fetch, test, restart at a safe moment)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/sdy2-update.sh %i
# The script may wait up to 12 hours for a safe moment (no shift, REST or PLANNED STOP).
TimeoutStartSec=13h
